{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "macaw",
  "version-string": "0.1.0",
  "builtin-baseline": "a1cae005c39be7b18ba319fced856b68d7276271",
  "dependencies": [
    "assimp",
    "directxtex",
    "fbxsdk",
    {
      "name": "freetype",
