    },
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "dx11-binding",
        "win32-binding"
      ]
    },
    "hlsl-language-server",
    "imanim",
    "imgui-color-text-edit",
    "imgui-neo-sequencer",
    "imgui-node-editor",
    "imterm",
    "lua-language-server",
    "luajit",
    "nvapi",
    "nvcloth",
    "physx",
    "range-v3",
    "rapidjson",
    "sol2",
    "stb",
    "tomlplusplus"
  ],
  "overrides": [
    {
      "name": "physx",
      "version-semver": "4.1.2#2"
    }
  ]
}
